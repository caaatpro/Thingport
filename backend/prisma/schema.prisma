generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id                       String         @id @default(cuid())
  email                    String         @unique
  passwordHash             String
  displayName              String
  role                     Role           @default(MEMBER)
  // Defaults true so existing accounts aren't locked out; registration sets false when SMTP is on.
  emailVerified            Boolean        @default(true)
  emailVerificationToken   String?        @unique
  emailVerificationExpires DateTime?
  // Awaiting confirmation of an email change.
  pendingEmail             String?
  // SHA-256 of the emailed token, so a database leak can't be used to take over accounts.
  passwordResetTokenHash   String?        @unique
  passwordResetExpires     DateTime?
  // Per-user, unlike the instance-wide Thingiverse token.
  makerworldCookie         String?
  slicer                   String?
  // "light" | "dark" | "system"; null means never set.
  themePreference          String?
  authorPreviewEnabled     Boolean        @default(true)
  // Filled from the first linked Author with this data; later links never overwrite it.
  bio                      String?
  backgroundUrl            String?
  categories               Category[]
  prints                   Print[]
  collections              Collection[]
  importJobs               ImportJob[]
  notifications            Notification[]
  logs                     Log[]
  authorLinks              AuthorLink[]
  bookmarks                Bookmark[]
  invitationsSent          Invitation[]
  // Targeted sharing: models/collections other users have shared with this user.
  printSharesReceived      PrintShare[]      @relation("PrintShareRecipient")
  collectionSharesReceived CollectionShare[] @relation("CollectionShareRecipient")
  apiTokens                ApiToken[]
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
}

// Lets one email register while registrations are closed. Re-inviting replaces the token.
model Invitation {
  id          String   @id @default(cuid())
  email       String   @unique
  token       String   @unique
  invitedById String?
  invitedBy   User?    @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  tags              String[]   @default([])
  parentId          String?
  parent            Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          Category[] @relation("CategoryTree")
  // Order among siblings. No unique index: Postgres treats NULL parentIds as distinct.
  position          Int        @default(0)
  metaTitle         String?
  metaDescription   String?
  // Imports whose site category id matches any of these land in this category. Each site has its
  // own id namespace.
  makerworldCatIds  Int[]      @default([])
  thingiverseCatIds Int[]      @default([])
  printablesCatIds  Int[]      @default([])
  prints            Print[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([userId, parentId, position])
  @@index([tags], type: Gin)
  @@index([makerworldCatIds], type: Gin)
  @@index([thingiverseCatIds], type: Gin)
  @@index([printablesCatIds], type: Gin)
}

model Print {
  id               String                   @id @default(cuid())
  userId           String
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  nameNormalized   String
  title            String?
  notes            String?
  creator          String?
  tags             String[]                 @default([])
  viewCount        Int                      @default(0)
  printCount       Int                      @default(0)
  // Back the Favourites and Browsing History pseudo-collections.
  favoritedAt      DateTime?
  lastViewedAt     DateTime?
  // Dedupes re-imports of the same design. Null for uploads and unidentifiable sources.
  sourceProvider   String?
  sourceExternalId String?
  categoryId       String?
  category         Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId         String?
  author           Author?                  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sourcePath       String?
  plates           Plate[]
  previewImages    PreviewImage[]
  files            PrintFile[]              @relation("PrintFiles")
  preparedFileId   String?                  @unique
  preparedFile     PrintFile?               @relation("PreparedFile", fields: [preparedFileId], references: [id], onDelete: SetNull)
  preparedMetadata Json?
  collectionItems  CollectionItem[]
  // Targeted sharing. A model is PRIVATE (owner only) when it has no shares; "Shared" in the UI
  // means shares.length > 0. The model's own share list is authoritative even inside a shared
  // collection, so a private model in a shared collection stays hidden from others.
  shares           PrintShare[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  // Generated column (name A, tags B, notes C, creator D) created with its GIN index in a
  // hand-written migration, since Prisma can't express a generated tsvector.
  searchVector     Unsupported("tsvector")?

  @@unique([userId, categoryId, nameNormalized])
  @@unique([userId, sourceProvider, sourceExternalId])
  @@index([userId, categoryId, name])
  @@index([tags], type: Gin)
  @@index([authorId])
  @@index([userId, favoritedAt])
  @@index([userId, lastViewedAt])
}

/// A user-curated group of models. Collection imports reuse a row by nameNormalized.
model Collection {
  id             String                   @id @default(cuid())
  userId         String
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  nameNormalized String
  description    String?
  tags           String[]                 @default([])
  items          CollectionItem[]
  bookmarks      Bookmark[]
  // Targeted sharing of the collection listing (see Print.shares for the per-model rule).
  shares         CollectionShare[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  // Generated column (name A, tags B, description C); see Print.searchVector.
  searchVector   Unsupported("tsvector")?

  @@unique([userId, nameNormalized])
  @@index([tags], type: Gin)
}

enum BookmarkType {
  TAG
  COLLECTION
}

/// A tag or collection pinned to the sidebar. Both kinds share one `order` sequence.
///
/// Exactly one of `tag` / `collectionId` is set, matching `type`. Postgres treats NULLs as
/// distinct, so each @@unique only dedupes its own type's rows.
model Bookmark {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         BookmarkType
  tag          String?
  collectionId String?
  collection   Collection?  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  order        Int
  createdAt    DateTime     @default(now())

  @@unique([userId, type, tag])
  @@unique([userId, collectionId])
  @@index([userId, order])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  printId      String
  print        Print      @relation(fields: [printId], references: [id], onDelete: Cascade)
  position     Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([collectionId, printId])
  @@index([collectionId, position])
  @@index([printId])
}

enum ImportJobType {
  COLLECTION
  ZIP
  PROFILES
}

enum ImportJobStatus {
  RUNNING
  DONE
  ERROR
}

/// A background batch import. At most one RUNNING job per user (enforced in routes/imports.ts).
model ImportJob {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               ImportJobType
  status             ImportJobStatus @default(RUNNING)
  sourceUrl          String
  sourceLabel        String?
  provider           String?
  total              Int             @default(0)
  processed          Int             @default(0)
  imported           Int             @default(0)
  alreadyInLibrary   Int             @default(0)
  failedCount        Int             @default(0)
  errorMessage       String?
  resultCollectionId String?
  // Set when the job created exactly one Print, so the frontend can open it directly.
  resultPrintId      String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId, status])
}

model Notification {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  body         String?
  externalUrl  String?
  internalPath String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// A creator on a source platform. `id` is provider-prefixed ("makerworld:3582000380") so
/// re-imports upsert the same row.
model Author {
  id            String      @id
  provider      String
  externalId    String
  name          String?
  handle        String?
  bio           String?
  bioTranslated String?
  links         String[]    @default([])
  avatarUrl     String?
  backgroundUrl String?
  prints        Print[]
  link          AuthorLink?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([provider, externalId])
}

/// Claims an Author as "this is me". An Author maps to at most one user, and a user has at most
/// one linked identity per provider.
model AuthorLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorId  String   @unique
  author    Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // Denormalized so the [userId, provider] unique index needs no join.
  provider  String
  createdAt DateTime @default(now())

  @@unique([userId, provider])
}

model Plate {
  id               String   @id @default(cuid())
  printId          String
  print            Print    @relation(fields: [printId], references: [id], onDelete: Cascade)
  position         Int
  filename         String
  mime             String
  size             Int      @default(0)
  storagePath      String   @unique
  sourcePath       String?
  // The MakerWorld profile ("instance") this file came from. Each profile's 3MF has its own print
  // settings, so each gets its own Plate.
  sourceInstanceId String?
  // Computed lazily; plate files are never rewritten in place.
  contentSha256    String?
  // Geometry bounding box (model units, mm by 3D-printing convention) + triangle count, filled when
  // the server renders a thumbnail for a mesh/CAD model. Null for files we don't measure.
  dimXmm           Float?
  dimYmm           Float?
  dimZmm           Float?
  triangleCount    Int?
  // Async post-upload processing (thumbnail/metadata/preview). Existing rows default to READY; new
  // uploads are set QUEUED and advanced by the ProcessingJob worker. Processing never blocks upload.
  processingStatus PlateProcessingStatus @default(READY)
  processingError  String?
  processingJobs   ProcessingJob[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([printId, position])
  @@unique([printId, sourceInstanceId])
  @@index([printId])
  @@index([processingStatus])
}

/// A photo of the finished model, stored as a normalized JPEG keyed by id. Position 0 is the
/// main image.
model PreviewImage {
  id        String   @id @default(cuid())
  printId   String
  print     Print    @relation(fields: [printId], references: [id], onDelete: Cascade)
  position  Int
  createdAt DateTime @default(now())

  @@unique([printId, position])
  @@index([printId])
}

enum PrintFileRole {
  SUPPORTING
  PREPARED
}

model PrintFile {
  id          String        @id @default(cuid())
  printId     String
  print       Print         @relation("PrintFiles", fields: [printId], references: [id], onDelete: Cascade)
  role        PrintFileRole
  filename    String
  mime        String
  size        Int           @default(0)
  storagePath String        @unique
  metadata    Json?
  createdAt   DateTime      @default(now())
  preparedFor Print?        @relation("PreparedFile")

  @@index([printId, role])
}

model Setting {
  key   String @id
  value Json
}

/// Admin audit trail. Written fire-and-forget so logging never breaks the action.
model Log {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  targetId  String?
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

enum PlateProcessingStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum ProcessingJobStatus {
  QUEUED
  RUNNING
  DONE
  ERROR
}

/// Grants one user read access to another user's Print (targeted, Google-Drive-style sharing).
/// Absence of any share = PRIVATE (owner only). Writes always stay owner-only.
model PrintShare {
  id               String   @id @default(cuid())
  printId          String
  print            Print    @relation(fields: [printId], references: [id], onDelete: Cascade)
  sharedWithUserId String
  sharedWithUser   User     @relation("PrintShareRecipient", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([printId, sharedWithUserId])
  @@index([sharedWithUserId])
}

/// Grants one user visibility of another user's Collection listing. Per-model access inside it is
/// still governed by PrintShare, so a private model in a shared collection stays hidden.
model CollectionShare {
  id               String     @id @default(cuid())
  collectionId     String
  collection       Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sharedWithUserId String
  sharedWithUser   User       @relation("CollectionShareRecipient", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime   @default(now())

  @@unique([collectionId, sharedWithUserId])
  @@index([sharedWithUserId])
}

/// Durable post-upload processing job for one plate (thumbnail/metadata/preview). Generalizes the
/// import-job pattern but, unlike imports, is re-enqueued on restart so work is never abandoned.
model ProcessingJob {
  id        String              @id @default(cuid())
  plateId   String
  plate     Plate               @relation(fields: [plateId], references: [id], onDelete: Cascade)
  status    ProcessingJobStatus @default(QUEUED)
  attempts  Int                 @default(0)
  error     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([status])
  @@index([plateId])
}

/// A revocable credential for non-browser clients such as the Thingport Grab extension, so they never
/// need the account password. Only the SHA-256 of the secret is stored: a database leak can't be used
/// to act as the user, and a token is revoked by deleting its row.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  // First characters of the secret, so a token can be told apart in the UI. Not enough to use it.
  prefix     String
  tokenHash  String    @unique
  // What the token may call. "grab" = only the endpoints the browser extension needs.
  scope      String    @default("grab")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?

  @@index([userId, createdAt])
}
